                  "    pm.expect(body.vehicle.plateNumber).to.eql(body.vehicle.plateNumber.toUpperCase());",
                  "});",
                  "pm.test('Location header points to the new driver', () => pm.expect(pm.response.headers.get('Location')).to.include(body.id));",
                  "pm.collectionVariables.set('driverId', body.id);"
