{
  "info": {
    "name": "RideLink - Driver & Vehicle Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Successful and negative scenarios for the Driver & Vehicle Service (port 8082).\n\nSetup: import the environment, set `jwtSecret` to the same value as the service's JWT_SECRET (min 32 chars), start MongoDB and the service, then run the collection in order. Tokens are generated by the collection pre-request script (HS256; claims sub, role, exp) until the Account Service issues real ones. Every run uses a fresh test identity."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const secret = pm.environment.get('jwtSecret');",
          "if (!secret || secret.length < 32) {",
          "    throw new Error('Set the \"jwtSecret\" environment variable to the same value as the service JWT_SECRET (min 32 characters).');",
          "}",
          "",
          "// A fresh test identity is generated every time the first request of the flow is sent,",
          "// so the whole collection can be re-run without cleaning MongoDB.",
          "const startsNewRun = pm.info.requestName.indexOf('H01') === 0;",
          "if (startsNewRun || !pm.collectionVariables.get('runId')) {",
          "    const runId = Date.now().toString().slice(-8);",
          "    pm.collectionVariables.set('runId', runId);",
          "    pm.collectionVariables.set('driverAccountId', 'driver-' + runId);",
          "    pm.collectionVariables.set('driver2AccountId', 'driver2-' + runId);",
          "    pm.collectionVariables.set('licenseNumber', 'LIC' + runId);",
          "    pm.collectionVariables.set('plateNumber', 'CAB-' + runId.slice(-6));",
          "    pm.collectionVariables.set('license2Number', 'LICB' + runId);",
          "    pm.collectionVariables.set('plate2Number', 'VAN-' + runId.slice(-6));",
          "}",
          "",
          "function b64url(wordArray) {",
          "    return CryptoJS.enc.Base64.stringify(wordArray).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "}",
          "function makeJwt(sub, role, key, ttlSeconds) {",
          "    const now = Math.floor(Date.now() / 1000);",
          "    const header = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify({ alg: 'HS256', typ: 'JWT' })));",
          "    const payload = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify({ sub: sub, role: role, iat: now, exp: now + ttlSeconds })));",
          "    const signature = b64url(CryptoJS.HmacSHA256(header + '.' + payload, key));",
          "    return header + '.' + payload + '.' + signature;",
          "}",
          "",
          "// Stand-ins for tokens the Account Service will issue (HS256, claims: sub, role, exp)",
          "const cv = pm.collectionVariables;",
          "cv.set('driverToken', makeJwt(cv.get('driverAccountId'), 'DRIVER', secret, 3600));",
          "cv.set('driver2Token', makeJwt(cv.get('driver2AccountId'), 'DRIVER', secret, 3600));",
          "cv.set('passengerToken', makeJwt('passenger-demo', 'PASSENGER', secret, 3600));",
          "cv.set('adminToken', makeJwt('admin-demo', 'ADMIN', secret, 3600));",
          "cv.set('serviceToken', makeJwt('ride-service', 'SERVICE', secret, 3600));",
          "cv.set('wrongSignatureToken', makeJwt(cv.get('driverAccountId'), 'DRIVER', 'a-completely-different-secret-0123456789', 3600));",
          "cv.set('expiredToken', makeJwt(cv.get('driverAccountId'), 'DRIVER', secret, -120));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0 - Service is up",
      "item": [
