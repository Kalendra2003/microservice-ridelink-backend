          "name": "OpenAPI document is reachable (public)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v3",
                "api-docs"
              ],
              "raw": "{{baseUrl}}/v3/api-docs"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Documents the drivers API', () => pm.expect(pm.response.text()).to.include('/api/v1/drivers'));"
                ]
              }
            }
          ]
        }
      ]
    },
