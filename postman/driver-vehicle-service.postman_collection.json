          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Profile starts OFFLINE', () => pm.expect(body.availabilityStatus).to.eql('OFFLINE'));",
                  "pm.test('Account id comes from the JWT subject', () => pm.expect(body.accountId).to.eql(pm.collectionVariables.get('driverAccountId')));",
                  "pm.test('Licence and plate are stored upper-case', () => {",
