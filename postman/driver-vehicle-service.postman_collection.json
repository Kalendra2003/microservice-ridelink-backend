            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nimal Perera\",\n  \"phoneNumber\": \"+94771234567\",\n  \"licenseNumber\": \"{{licenseNumber}}\",\n  \"serviceArea\": \"Colombo\",\n  \"vehicle\": {\n    \"plateNumber\": \"{{plateNumber}}\",\n    \"make\": \"Toyota\",\n    \"model\": \"Axio\",\n    \"color\": \"White\",\n    \"vehicleType\": \"CAR\",\n    \"seatCapacity\": 4,\n    \"manufactureYear\": 2020\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
